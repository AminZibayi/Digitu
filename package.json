{
  "name": "digikala-auto-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Digikala Product and Variant Automation Suite",
  "scripts": {
    "dev": "pnpm --filter @digikala/frontend dev",
    "build:core": "pnpm --filter @digikala/core build",
    "build:services": "pnpm --filter @digikala/product-uploader build && pnpm --filter @digikala/variant-creator build",
    "build:frontend": "pnpm --filter @digikala/frontend build",
    "build:backend": "pnpm --filter @digikala/backend build",
    "build:desktop": "pnpm --filter @digikala/desktop build",
    "build:packages": "pnpm run build:core && pnpm run build:services",
    "build": "pnpm run build:packages && pnpm run build:frontend && pnpm run build:desktop && pnpm run build:backend",
    "backend:start": "pnpm --filter @digikala/backend start",
    "desktop:dev": "pnpm --filter @digikala/desktop dev",
    "desktop:compile": "pnpm --filter @digikala/desktop compile",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "nx": "22.7.1"
  }
}