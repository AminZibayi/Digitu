{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["npx", "nx", "mcp"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "websearch": "allow",
      "question": "allow",
      "Stop-Process*": "ask",
      "Kill-Process*": "ask",
      "taskkill*": "ask",
      "*-Force*": "ask",
      "rm*": "ask",
      "Get-Process*": "ask"
    }
  }
}
