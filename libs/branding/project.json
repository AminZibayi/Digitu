{
  "name": "branding",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/branding/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project branding --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd libs/branding && npx tsc -p tsconfig.lib.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node libs/branding/scripts/generate-assets.ts"
      }
    }
  }
}
