{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digikala Variant Creator Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "api", "variantDefaults", "sizes", "pricing"],
  "properties": {
    "version": {
      "type": "number"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "cookie", "referer", "themeId"],
      "properties": {
        "baseUrl": { "type": "string", "minLength": 1 },
        "cookie": { "type": "string", "minLength": 1 },
        "referer": { "type": "string", "minLength": 1 },
        "themeId": { "type": "integer", "minimum": 1 },
        "site": { "type": "string", "default": "digikala" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "default": 20000 },
        "maxRetries": { "type": "integer", "minimum": 0, "default": 3 },
        "retryDelayMs": { "type": "integer", "minimum": 0, "default": 600 }
      }
    },
    "variantDefaults": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "package_weight",
        "package_length",
        "package_height",
        "package_width",
        "lead_time",
        "marketplace_seller_stock",
        "order_limit",
        "warranty_id",
        "is_active",
        "supplier_code",
        "fbs_lead_time",
        "shipping_type"
      ],
      "properties": {
        "package_weight": { "type": "integer", "minimum": 1 },
        "package_length": { "type": "integer", "minimum": 1 },
        "package_height": { "type": "integer", "minimum": 1 },
        "package_width": { "type": "integer", "minimum": 1 },
        "lead_time": { "type": "integer", "minimum": 0 },
        "marketplace_seller_stock": { "type": "integer", "minimum": 0 },
        "order_limit": { "type": "integer", "minimum": 0 },
        "warranty_id": { "type": "integer", "minimum": 1 },
        "is_active": { "type": "boolean" },
        "supplier_code": { "type": "string" },
        "fbs_lead_time": { "type": "integer", "minimum": 0 },
        "shipping_type": { "type": "string", "enum": ["both", "fbs", "marketplace"] }
      }
    },
    "variantDefaultsBySize": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "themeValueId"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "themeValueId": { "type": "integer", "minimum": 1 },
          "active": { "type": "boolean", "default": true }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCurrency", "basePriceBySize", "conflictResolution", "rules"],
      "properties": {
        "baseCurrency": { "type": "string", "minLength": 1 },
        "usdToBaseRate": { "type": "number", "exclusiveMinimum": 0 },
        "defaultBasePrice": { "type": "number", "exclusiveMinimum": 0 },
        "basePriceBySize": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "conflictResolution": {
          "type": "string",
          "enum": ["first-match-wins", "last-match-wins"]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "priority", "when", "then"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer" },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sizesAny": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "titleIncludesAny": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "titleExcludesAny": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "setBasePrice": { "type": "number", "exclusiveMinimum": 0 },
                  "setUsdPrice": { "type": "number", "exclusiveMinimum": 0 },
                  "overrideFields": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "stateFile": { "type": "string", "default": "idempotency-state.json" }
      }
    }
  }
}
