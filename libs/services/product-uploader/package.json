{
  "name": "digikala-auto-uploader",
  "version": "1.0.0",
  "description": "Automated bulk product uploader for Digikala Seller Platform - Category 6946 (تابلو)",
  "main": "cli.js",
  "bin": {
    "digikala": "cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "validate": "node cli.js --validate products.csv",
    "upload": "node cli.js --upload products.csv",
    "dry-run": "node cli.js --dry-run products.csv",
    "help": "node cli.js --help"
  },
  "keywords": [
    "digikala",
    "seller",
    "automation",
    "bulk-upload",
    "csv",
    "api",
    "إيران",
    "farsi",
    "persian"
  ],
  "author": "",
