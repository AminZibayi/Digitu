  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "csv-parse": "^5.5.0",
    "dotenv": "^17.3.1",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/digikala-auto-uploader"
  },
  "bugs": {
