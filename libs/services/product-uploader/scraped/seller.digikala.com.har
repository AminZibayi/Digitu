mount:\"\\u0627\\u0641\\u0632\\u0627\\u06CC\\u0634 \\u0627\\u0639\\u062A\\u0628\\u0627\\u0631\",benefits:\"\\u0645\\u0632\\u06CC\\u062A\\u200C\\u0647\\u0627\",preview:\"\\u067E\\u06CC\\u0634\\u200C\\u0646\\u0645\\u0627\\u06CC\\u0634\",disabled:\"(\\u0645\\u0648\\u0642\\u062A\\u0627 \\u063A\\u06CC\\u0631\\u0641\\u0639\\u0627\\u0644)\",adServices:\"\\u0633\\u0631\\u0648\\u06CC\\u0633\\u200C\\u0647\\u0627\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A\\u06CC\",adSpecificServices:\"\\u0633\\u0631\\u0648\\u06CC\\u0633\\u200C\\u0647\\u0627\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A\\u06CC \\u0648\\u06CC\\u0698\\u0647\",formSuccess:\"\\u062F\\u0631\\u062E\\u0648\\u0627\\u0633\\u062A \\u0634\\u0645\\u0627 \\u0628\\u0627 \\u0645\\u0648\\u0641\\u0642\\u06CC\\u062A \\u062B\\u0628\\u062A \\u0634\\u062F\",faq:{title:\"\\u0633\\u0648\\u0627\\u0644\\u0627\\u062A \\u067E\\u0631\\u062A\\u06A9\\u0631\\u0627\\u0631\",items:[{question:\"\\u06F1. \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0627\\u062F\\u0632 \\u0686\\u06CC\\u0633\\u062A \\u0648 \\u0686\\u0647 \\u062E\\u062F\\u0645\\u0627\\u062A\\u06CC \\u0627\\u0631\\u0627\\u0626\\u0647 \\u0645\\u06CC\\u200C\\u062F\\u0647\\u062F\\u061F\",answer:\"\\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0627\\u062F\\u0632 \\u0628\\u0627\\u0632\\u0648\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A\\u06CC \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627\\u0633\\u062A \\u06A9\\u0647 \\u0628\\u0627 \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u0627\\u0632 \\u0631\\u0627\\u0647\\u06A9\\u0627\\u0631\\u0647\\u0627\\u06CC \\u0646\\u0648\\u0622\\u0648\\u0631\\u0627\\u0646\\u0647 \\u0648 \\u0645\\u0628\\u062A\\u0646\\u06CC \\u0628\\u0631 \\u062F\\u0627\\u062F\\u0647\\u060C \\u0628\\u0647 \\u0631\\u0634\\u062F \\u06A9\\u0633\\u0628\\u200C\\u0648\\u06A9\\u0627\\u0631\\u0647\\u0627 \\u06A9\\u0645\\u06A9 \\u0645\\u06CC\\u200C\\u06A9\\u0646\\u062F \\u062A\\u0627 \\u062F\\u06CC\\u062F\\u0647 \\u0634\\u0648\\u0646\\u062F\\u060C \\u0641\\u0631\\u0648\\u0634\\u200C\\u0634\\u0627\\u0646 \\u0631\\u0627 \\u0627\\u0641\\u0632\\u0627\\u06CC\\u0634 \\u062F\\u0647\\u0646\\u062F \\u0648 \\u0627\\u0631\\u062A\\u0628\\u0627\\u0637 \\u0645\\u0648\\u062B\\u0631\\u062A\\u0631\\u06CC \\u0628\\u0627 \\u0645\\u062E\\u0627\\u0637\\u0628\\u0627\\u0646 \\u0628\\u0631\\u0642\\u0631\\u0627\\u0631 \\u06A9\\u0646\\u0646\\u062F.\"},{question:\"\\u06F2. \\u0622\\u06CC\\u0627 \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u0627\\u0632 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0627\\u062F\\u0632 \\u0641\\u0642\\u0637 \\u0628\\u0631\\u0627\\u06CC \\u0628\\u0631\\u0646\\u062F\\u0647\\u0627\\u06CC \\u0628\\u0632\\u0631\\u06AF \\u0627\\u0633\\u062A\\u061F\",answer:\"\\u062E\\u06CC\\u0631. \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0627\\u062F\\u0632 \\u0628\\u0631\\u0627\\u06CC \\u0647\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u0627\\u0646 \\u0648 \\u0628\\u0631\\u0646\\u062F\\u0647\\u0627 \\u062F\\u0631 \\u062F\\u0633\\u062A\\u0631\\u0633 \\u0627\\u0633\\u062A\\u061B \\u0627\\u0632 \\u06A9\\u0633\\u0628\\u200C\\u0648\\u06A9\\u0627\\u0631\\u0647\\u0627\\u06CC \\u06A9\\u0648\\u0686\\u06A9 \\u062A\\u0627 \\u0628\\u0631\\u0646\\u062F\\u0647\\u0627\\u06CC \\u0634\\u0646\\u0627\\u062E\\u062A\\u0647\\u200C\\u0634\\u062F\\u0647. \\u0647\\u0631 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u062A\\u0648\\u0627\\u0646\\u062F \\u0645\\u062A\\u0646\\u0627\\u0633\\u0628 \\u0628\\u0627 \\u0628\\u0648\\u062F\\u062C\\u0647 \\u0648 \\u0647\\u062F\\u0641 \\u062E\\u0648\\u062F \\u0627\\u0632 \\u0627\\u06CC\\u0646 \\u062E\\u062F\\u0645\\u0627\\u062A \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u06A9\\u0646\\u062F.\"},{question:\"\\u06F3. \\u0686\\u0631\\u0627 \\u0628\\u0627\\u06CC\\u062F \\u062F\\u0631 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u062A\\u0628\\u0644\\u06CC\\u063A \\u06A9\\u0646\\u0645 \\u0648 \\u0686\\u0637\\u0648\\u0631 \\u0645\\u06CC\\u200C\\u062A\\u0648\\u0627\\u0646\\u0645 \\u0628\\u06CC\\u0634\\u062A\\u0631\\u06CC\\u0646 \\u0628\\u0627\\u0632\\u062F\\u0647\\u06CC \\u0631\\u0627 \\u062F\\u0627\\u0634\\u062A\\u0647 \\u0628\\u0627\\u0634\\u0645\\u061F\",answer:\"\\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A \\u062F\\u0631 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0628\\u0647 \\u062F\\u0644\\u06CC\\u0644 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u06AF\\u0633\\u062A\\u0631\\u062F\\u0647 \\u0628\\u0647 \\u0645\\u0634\\u062A\\u0631\\u06CC\\u0627\\u0646\\u060C \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u0627\\u0632 \\u062F\\u0627\\u062F\\u0647\\u200C\\u0647\\u0627\\u06CC \\u0647\\u0648\\u0634\\u0645\\u0646\\u062F \\u0648 \\u0627\\u0628\\u0632\\u0627\\u0631\\u0647\\u0627\\u06CC \\u0645\\u062A\\u0646\\u0648\\u0639\\u060C \\u06CC\\u06A9\\u06CC \\u0627\\u0632 \\u0628\\u0647\\u062A\\u0631\\u06CC\\u0646 \\u0631\\u0648\\u0634\\u200C\\u0647\\u0627 \\u0628\\u0631\\u0627\\u06CC \\u0627\\u0641\\u0632\\u0627\\u06CC\\u0634 \\u0641\\u0631\\u0648\\u0634 \\u0648 \\u0622\\u06AF\\u0627\\u0647\\u06CC \\u0627\\u0632 \\u0628\\u0631\\u0646\\u062F \\u0627\\u0633\\u062A. \\u0628\\u0627 \\u0627\\u0646\\u062A\\u062E\\u0627\\u0628 \\u0627\\u0633\\u062A\\u0631\\u0627\\u062A\\u0698\\u06CC \\u0645\\u0646\\u0627\\u0633\\u0628\\u060C \\u0645\\u06CC\\u200C\\u062A\\u0648\\u0627\\u0646\\u06CC\\u062F \\u0627\\u0632 \\u0627\\u06CC\\u0646 \\u0628\\u0633\\u062A\\u0631 \\u0628\\u0631\\u0627\\u06CC \\u0631\\u0634\\u062F \\u06A9\\u0633\\u0628\\u200C\\u0648\\u06A9\\u0627\\u0631\\u062A\\u0627\\u0646 \\u0628\\u0647\\u0631\\u0647 \\u0628\\u0628\\u0631\\u06CC\\u062F.\"},{question:\"\\u06F4. \\u0686\\u0631\\u0627 \\u0628\\u0627\\u06CC\\u062F \\u0627\\u0632 \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A \\u062C\\u0633\\u062A\\u062C\\u0648\\u0645\\u062D\\u0648\\u0631 \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u06A9\\u0646\\u0645\\u061F\",answer:\"\\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A \\u062C\\u0633\\u062A\\u062C\\u0648\\u0645\\u062D\\u0648\\u0631 \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0634\\u0645\\u0627 \\u0631\\u0627 \\u062F\\u0631 \\u062C\\u0627\\u06CC\\u06AF\\u0627\\u0647\\u200C\\u0647\\u0627\\u06CC \\u0628\\u0627\\u0644\\u0627\\u06CC \\u0646\\u062A\\u0627\\u06CC\\u062C \\u062C\\u0633\\u062A\\u200C\\u0648\\u062C\\u0648 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u0645\\u06CC\\u200C\\u062F\\u0647\\u062F\\u061B \\u062C\\u0627\\u06CC\\u06CC \\u06A9\\u0647 \\u06A9\\u0627\\u0631\\u0628\\u0631\\u0627\\u0646 \\u062F\\u0642\\u06CC\\u0642\\u0627\\u064B \\u062F\\u0631 \\u062D\\u0627\\u0644 \\u062A\\u0635\\u0645\\u06CC\\u0645\\u200C\\u06AF\\u06CC\\u0631\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u062E\\u0631\\u06CC\\u062F \\u0647\\u0633\\u062A\\u0646\\u062F. \\u0627\\u06CC\\u0646 \\u0646\\u0648\\u0639 \\u062A\\u0628\\u0644\\u06CC\\u063A \\u0628\\u0647 \\u062F\\u06CC\\u062F\\u0647\\u200C\\u0634\\u062F\\u0646 \\u0628\\u06CC\\u0634\\u062A\\u0631 \\u0648 \\u062C\\u0630\\u0628 \\u062E\\u0631\\u06CC\\u062F\\u0627\\u0631 \\u0648\\u0627\\u0642\\u0639\\u06CC \\u06A9\\u0645\\u06A9 \\u0645\\u06CC\\u200C\\u06A9\\u0646\\u062F \\u0648 \\u0645\\u0639\\u0645\\u0648\\u0644\\u0627\\u064B \\u0646\\u0631\\u062E \\u062A\\u0628\\u062F\\u06CC\\u0644 \\u0628\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u062F\\u0627\\u0631\\u062F.\"},{question:\"\\u06F5. \\u0686\\u0631\\u0627 \\u0628\\u0627\\u06CC\\u062F \\u0627\\u0632 \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A \\u0634\\u06AF\\u0641\\u062A\\u200C\\u0627\\u0646\\u06AF\\u06CC\\u0632 \\u0633\\u0641\\u0627\\u0631\\u0634\\u06CC \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u06A9\\u0646\\u0645\\u061F\",answer:\"\\u0635\\u0641\\u062D\\u0647 \\u0634\\u06AF\\u0641\\u062A\\u200C\\u0627\\u0646\\u06AF\\u06CC\\u0632 \\u06CC\\u06A9\\u06CC \\u0627\\u0632 \\u067E\\u0631\\u0628\\u0627\\u0632\\u062F\\u06CC\\u062F\\u062A\\u0631\\u06CC\\u0646 \\u0628\\u062E\\u0634\\u200C\\u0647\\u0627\\u06CC \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627\\u0633\\u062A. \\u0648\\u0642\\u062A\\u06CC \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0634\\u0645\\u0627 \\u062F\\u0631 \\u0627\\u06CC\\u0646 \\u0635\\u0641\\u062D\\u0647 \\u0642\\u0631\\u0627\\u0631 \\u0645\\u06CC\\u200C\\u06AF\\u06CC\\u0631\\u062F\\u060C \\u0634\\u0627\\u0646\\u0633 \\u062F\\u06CC\\u062F\\u0647\\u200C\\u0634\\u062F\\u0646 \\u0648 \\u0641\\u0631\\u0648\\u0634\\u200C\\u062A\\u0627\\u0646 \\u0628\\u06CC\\u0634\\u062A\\u0631 \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u0642\\u0627\\u0628\\u0644\\u200C\\u062A\\u0648\\u062C\\u0647\\u06CC \\u0628\\u0627\\u0644\\u0627 \\u0645\\u06CC\\u200C\\u0631\\u0648\\u062F.\"},{question:\"\\u06F6. \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A \\u062C\\u0633\\u062A\\u062C\\u0648\\u0645\\u062D\\u0648\\u0631 \\u06A9\\u062C\\u0627 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0627\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F\\u061F\",answer:\"\\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0634\\u0645\\u0627 \\u062F\\u0631 \\u0628\\u0627\\u0644\\u0627\\u06CC \\u0635\\u0641\\u062D\\u0647 \\u0646\\u062A\\u0627\\u06CC\\u062C \\u062C\\u0633\\u062A\\u200C\\u0648\\u062C\\u0648 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0627\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F\\u061B \\u062C\\u0627\\u06CC\\u06AF\\u0627\\u0647\\u06CC \\u06A9\\u0647 \\u0628\\u06CC\\u0634\\u062A\\u0631\\u06CC\\u0646 \\u0628\\u0627\\u0632\\u062F\\u06CC\\u062F \\u0631\\u0627 \\u062F\\u0627\\u0631\\u062F.\"},{question:\"\\u06F7. \\u062C\\u0627\\u06CC\\u06AF\\u0627\\u0647 \\u062A\\u0628\\u0644\\u06CC\\u063A \\u062F\\u0631 \\u0634\\u06AF\\u0641\\u062A\\u200C\\u0627\\u0646\\u06AF\\u06CC\\u0632 \\u06A9\\u062C\\u0627\\u0633\\u062A\\u061F\",answer:\"\\u0628\\u062E\\u0634 \\u0634\\u06AF\\u0641\\u062A\\u200C\\u0627\\u0646\\u06AF\\u06CC\\u0632 \\u062F\\u0631 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627\\u060C \\u067E\\u0631\\u0628\\u0627\\u0632\\u062F\\u06CC\\u062F\\u062A\\u0631\\u06CC\\u0646 \\u0628\\u062E\\u0634 \\u0633\\u0627\\u06CC\\u062A \\u0627\\u0633\\u062A. \\u0628\\u0627 \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u0627\\u0632 \\u0627\\u06CC\\u0646 \\u062A\\u0628\\u0644\\u06CC\\u063A\\u060C \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0634\\u0645\\u0627 \\u062F\\u0631 \\u0647\\u0645\\u06CC\\u0646 \\u0628\\u062E\\u0634 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0627\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F.\"},{question:\"\\u06F8. \\u06A9\\u062F\\u0627\\u0645 \\u0633\\u0631\\u0648\\u06CC\\u0633 \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u0645\\u0646 \\u0645\\u0646\\u0627\\u0633\\u0628\\u200C\\u062A\\u0631 \\u0627\\u0633\\u062A\\u061F\",answer:\"\\u0628\\u0633\\u062A\\u0647 \\u0628\\u0647 \\u0647\\u062F\\u0641 \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0627\\u062A\\u06CC\\u060C \\u0628\\u0648\\u062F\\u062C\\u0647 \\u0648 \\u0646\\u0648\\u0639 \\u06A9\\u0627\\u0644\\u0627\\u060C \\u0645\\u06CC\\u200C\\u062A\\u0648\\u0627\\u0646\\u06CC\\u062F \\u0627\\u0632 \\u0637\\u06CC\\u0641 \\u0648\\u0633\\u06CC\\u0639\\u06CC \\u0627\\u0632 \\u0633\\u0631\\u0648\\u06CC\\u0633\\u200C\\u0647\\u0627\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u0639\\u0627\\u062A\\u06CC \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627 \\u0627\\u062F\\u0632 \\u0627\\u0633\\u062A\\u0641\\u0627\\u062F\\u0647 \\u06A9\\u0646\\u06CC\\u062F. \\u0627\\u06CC\\u0646 \\u0627\\u0628\\u0632\\u0627\\u0631\\u0647\\u0627 \\u0628\\u0631\\u0627\\u06CC \\u0627\\u0647\\u062F\\u0627\\u0641 \\u0645\\u062A\\u0641\\u0627\\u0648\\u062A \\u0627\\u0632 \\u0622\\u06AF\\u0627\\u0647\\u06CC \\u0627\\u0632 \\u0628\\u0631\\u0646\\u062F \\u062A\\u0627 \\u0627\\u0641\\u0632\\u0627\\u06CC\\u0634 \\u0641\\u0631\\u0648\\u0634 \\u0637\\u0631\\u0627\\u062D\\u06CC \\u0634\\u062F\\u0646\\u060C \\u0631\\u0627\\u0647\\u0646\\u0645\\u0627\\u06CC \\u0632\\u06CC\\u0631 \\u0647\\u0631 \\u0633\\u0631\\u0648\\u06CC\\u0633 \\u0628\\u0647 \\u0634\\u0645\\u0627 \\u06A9\\u0645\\u06A9 \\u0645\\u06CC\\u200C\\u06A9\\u0646\\u062F \\u0627\\u0646\\u062A\\u062E\\u0627\\u0628 \\u062F\\u0642\\u06CC\\u0642\\u200C\\u062A\\u0631\\u06CC \\u062F\\u0627\\u0634\\u062A\\u0647 \\u0628\\u0627\\u0634\\u06CC\\u062F.\"},{question:\"\\u06F9. \\u067E\\u0631\\u062F\\u0627\\u062E\\u062A \\u0628\\u0647\\u200C\\u0627\\u0632\\u0627\\u06CC \\u06A9\\u0644\\u06CC\\u06A9 \\u06CC\\u0639\\u0646\\u06CC \\u0686\\u0647\\u061F\",answer:\"\\u062F\\u0631 \\u0627\\u06CC\\u0646 \\u0645\\u062F\\u0644\\u060C \\u0641\\u0642\\u0637 \\u0632\\u0645\\u0627\\u0646\\u06CC \\u06A9\\u0647 \\u06A9\\u0627\\u0631\\u0628\\u0631 \\u0631\\u0648\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u063A \\u0645\\u062D\\u0635\\u0648\\u0644 \\u0634\\u0645\\u0627 \\u06A9\\u0644\\u06CC\\u06A9 \\u06A9\\u0646\\u062F\\u060C \\u0647\\u0632\\u06CC\\u0646\\u0647\\u200C\\u0627\\u06CC \\u0627\\u0632 \\u0634\\u0645\\u0627 \\u06A9\\u0633\\u0631 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F.\"},{question:\"\\u06F1\\u06F0. \\u067E\\u0631\\u062F\\u0627\\u062E\\u062A \\u062F\\u0631 \\u0628\\u0627\\u0632\\u0647 \\u0632\\u0645\\u0627\\u0646\\u06CC \\u0628\\u0647 \\u0686\\u0647 \\u0645\\u0639\\u0646\\u0627\\u0633\\u062A\\u061F\",answer:\"\\u062F\\u0631 \\u0627\\u06CC\\u0646 \\u0645\\u062F\\u0644\\u060C \\u0647\\u0632\\u06CC\\u0646\\u0647 \\u062A\\u0628\\u0644\\u06CC\\u063A \\u0628\\u0631 \\u0627\\u0633\\u0627\\u0633 \\u0645\\u062F\\u062A\\u200C\\u0632\\u0645\\u0627\\u0646\\u06CC \\u06A9\\u0647 \\u0645\\u062D\\u0635\\u0648\\u0644 \\u0634\\u0645\\u0627 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0627\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F\\u060C \\u0645\\u062D\\u0627\\u0633\\u0628\\u0647 \\u062E\\u0648\\u0627\\u0647\\u062F \\u0634\\u062F.\"},{question:\"\\u06F1\\u06F1. \\u06A9\\u0645\\u067E\\u06CC\\u0646 \\u0633\\u0627\\u062E\\u062A\\u0647\\u200C\\u0627\\u0645 \\u0648\\u0644\\u06CC \\u062A\\u0628\\u0644\\u06CC\\u063A\\u0645 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u0646\\u062F\\u0627\\u0631\\u062F \\u06CC\\u0627 \\u0627\\u0632 \\u0628\\u0648\\u062F\\u062C\\u0647 \\u06A9\\u0645 \\u0646\\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F\\u061B \\u0645\\u0634\\u06A9\\u0644 \\u06A9\\u062C\\u0627\\u0633\\u062A\\u061F\",answer:\"\\u0645\\u0639\\u0645\\u0648\\u0644\\u0627\\u064B \\u0627\\u06CC\\u0646 \\u0645\\u0648\\u0636\\u0648\\u0639 \\u0628\\u0647 \\u067E\\u0627\\u06CC\\u06CC\\u0646 \\u0628\\u0648\\u062F\\u0646 \\u0642\\u06CC\\u0645\\u062A \\u067E\\u06CC\\u0634\\u0646\\u0647\\u0627\\u062F\\u06CC \\u0634\\u0645\\u0627 \\u0628\\u0631\\u0627\\u06CC \\u0647\\u0631 \\u06A9\\u0644\\u06CC\\u06A9 \\u0645\\u0631\\u0628\\u0648\\u0637 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F. \\u0628\\u0631\\u0627\\u06CC \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0631 \\u0635\\u0641\\u062D\\u0647 \\u0627\\u0648\\u0644 \\u0646\\u062A\\u0627\\u06CC\\u062C \\u062C\\u0633\\u062A\\u200C\\u0648\\u062C\\u0648\\u060C \\u067E\\u06CC\\u0634\\u0646\\u0647\\u0627\\u062F\\u062A\\u0627\\u0646 \\u0628\\u0627\\u06CC\\u062F \\u0627\\u0632 \\u0633\\u0627\\u06CC\\u0631 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647\\u200C\\u0647\\u0627 \\u0628\\u0627\\u0644\\u0627\\u062A\\u0631 \\u0628\\u0627\\u0634\\u062F. \\u062A\\u0648\\u062C\\u0647 \\u062F\\u0627\\u0634\\u062A\\u0647 \\u0628\\u0627\\u0634\\u06CC\\u062F \\u06A9\\u0647 \\u0642\\u06CC\\u0645\\u062A\\u200C\\u0647\\u0627 \\u0645\\u06CC\\u200C\\u062A\\u0648\\u0627\\u0646\\u0646\\u062F \\u0644\\u062D\\u0638\\u0647\\u200C\\u0627\\u06CC \\u062A\\u063A\\u06CC\\u06CC\\u0631 \\u06A9\\u0646\\u0646\\u062F\\u060C \\u0628\\u0646\\u0627\\u0628\\u0631\\u0627\\u06CC\\u0646 \\u0628\\u0647\\u062A\\u0631 \\u0627\\u0633\\u062A \\u06A9\\u0645\\u06CC \\u0628\\u0627\\u0644\\u0627\\u062A\\u0631 \\u0627\\u0632 \\u062D\\u062F\\u0627\\u0642\\u0644 \\u0634\\u0631\\u0648\\u0639 \\u06A9\\u0646\\u06CC\\u062F \\u062A\\u0627 \\u0634\\u0627\\u0646\\u0633 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u0628\\u06CC\\u0634\\u062A\\u0631\\u06CC \\u062F\\u0627\\u0634\\u062A\\u0647 \\u0628\\u0627\\u0634\\u06CC\\u062F.\"},{question:\"\\u06F1\\u06F2. \\u200C\\u0628\\u0627\\u06CC\\u200C\\u0628\\u0627\\u06A9\\u0633 \\u0686\\u06CC\\u0633\\u062A\\u061F\",answer:\"\\u0648\\u0642\\u062A\\u06CC \\u0686\\u0646\\u062F \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647 \\u06CC\\u06A9 \\u06A9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u0645\\u06CC\\u200C\\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u060C \\u062A\\u0646\\u0647\\u0627 \\u06CC\\u06A9\\u06CC \\u0627\\u0632 \\u0622\\u0646\\u200C\\u0647\\u0627 \\u0628\\u0647\\u200C\\u0639\\u0646\\u0648\\u0627\\u0646 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647 \\u0627\\u0635\\u0644\\u06CC \\u062F\\u0631 \\u0635\\u0641\\u062D\\u0647 \\u0645\\u062D\\u0635\\u0648\\u0644 \\u0646\\u0645\\u0627\\u06CC\\u0634 \\u062F\\u0627\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u062F. \\u0628\\u0647 \\u0627\\u06CC\\u0646 \\u062C\\u0627\\u06CC\\u06AF\\u0627\\u0647 \\xab\\u0628\\u0631\\u0646\\u062F\\u0647 \\u200Cbuy box\\xbb \\u0645\\u06CC\\u200C\\u06AF\\u0648\\u06CC\\u0646\\u062F. \\u0633\\u0627\\u06CC\\u0631 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647\\u200C\\u0647\\u0627 \\u062F\\u0631 \\u0644\\u06CC\\u0633\\u062A \\u067E\\u0627\\u06CC\\u06CC\\u0646\\u200C\\u062A\\u0631 \\u062F\\u06CC\\u062F\\u0647 \\u0645\\u06CC\\u200C\\u0634\\u0648\\u0646\\u062F \\u0648 \\u0633\\u0647\\u0645 \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0645\\u062A\\u0631\\u06CC \\u062F\\u0627\\u0631\\u0646\\u062F. \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647\\u200C\\u0627\\u06CC \\u06A9\\u0647 \\u0628\\u0627\\u06CC\\u200C\\u0628\\u0627\\u06A9\\u0633 \\u0631\\u0627 \\u0628\\u0628\\u0631\\u062F\\u060C \\u0628\\u06CC\\u0634 \\u0627\\u0632 \\u06F8\\u06F0\\u066A \\u0641\\u0631\\u0648\\u0634 \\u0622\\u0646 \\u06A9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u062F\\u0631 \\u0627\\u062E\\u062A\\u06CC\\u0627\\u0631 \\u062F\\u0627\\u0631\\u062F.\"},{question:\"\\u06F1\\u06F3. \\u0622\\u06CC\\u0627 \\u0628\\u0631\\u0627\\u06CC \\u0627\\u