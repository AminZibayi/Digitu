62F \\u0628\\u0648\\u062F\\u0646 \\u06A9\\u0627\\u0644\\u0627</td>\\n  </tr>\\n  <tr>\\n    <td>\\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647</td>\\n    <td>\\u0642\\u06CC\\u0645\\u062A\\u200C\\u06AF\\u0630\\u0627\\u0631\\u06CC \\u0627\\u0634\\u062A\\u0628\\u0627\\u0647</td>\\n  </tr>\\n  <tr>\\n    <td>\\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647</td>\\n    <td>\\u0642\\u0637\\u0639 \\u0647\\u0645\\u06A9\\u0627\\u0631\\u06CC</td>\\n  </tr>\\n  <tr>\\n  \\n    <td>\\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627</td>\\n    <td>\\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u063A\\u06CC\\u0631\\u0645\\u062C\\u0627\\u0632</td>\\n  </tr>\\n  <tr>\\n    <td rowspan=\"2\">\\n      \\u06F5\\xd7 \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\xd7 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\n    </td>\\n    <td>\\u0633\\u06CC\\u0633\\u062A\\u0645\\u06CC</td>\\n    <td>\\n      <p style=\"text-decoration: line-through;\">\\u0637\\u0648\\u0644\\u0627\\u0646\\u06CC \\u0634\\u062F\\u0646 \\u0632\\u0645\\u0627\\u0646 \\u062A\\u0623\\u0645\\u06CC\\u0646 \\u06A9\\u0627\\u0644\\u0627</p>\\n      <p style=\"color: red;\">\\u062C\\u0627\\u06CC\\u06AF\\u0632\\u06CC\\u0646 \\u0634\\u062F\\u0647 \\u0628\\u0627 \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u0623\\u062E\\u06CC\\u0631 \\u062F\\u0631 \\u062A\\u0623\\u0645\\u06CC\\u0646 \\u06A9\\u0627\\u0644\\u0627</p>\\n    </td>\\n  </tr>\\n  <tr>\\n  \\n    <td>\\u0633\\u06CC\\u0633\\u062A\\u0645\\u06CC</td>\\n    <td>\\u0637\\u0648\\u0644\\u0627\\u0646\\u06CC \\u0634\\u062F\\u0646 \\u0632\\u0645\\u0627\\u0646 \\u062A\\u0627\\u0645\\u06CC\\u0646 \\u06A9\\u0627\\u0644\\u0627 ( \\u0627\\u0631\\u0633\\u0627\\u0644 \\u062A\\u0648\\u0633\\u0637 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647)</td>\\n  </tr>\\n</tbody>\\n</table>\\n\\n<p style=\"text-align: center; margin-top: 8px;\">\\n(\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646)\\n</p>\\n</div>',titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0644\\u063A\\u0648 \\u0628\\u0631 \\u0639\\u0647\\u062F\\u0647 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647 (\\u0627\\u0632 \\u0633\\u0648\\u06CC \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647 \\u06CC\\u0627 \\u0644\\u063A\\u0648 \\u0627\\u062A\\u0648\\u0645\\u0627\\u062A\\u06CC\\u06A9 \\u0628\\u0647 \\u062F\\u0644\\u06CC\\u0644 \\u0639\\u062F\\u0645 \\u0627\\u0631\\u0633\\u0627\\u0644 \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 \\u062A\\u0627 \\u0632\\u0645\\u0627\\u0646 \\u062A\\u0639\\u0647\\u062F \\u062A\\u062D\\u0648\\u06CC\\u0644)\",contentStr:\"\\u0645\\u062D\\u062F\\u0648\\u062F\\u06CC\\u062A \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC: \\u0644\\u063A\\u0648 \\u0633\\u0641\\u0627\\u0631\\u0634 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F2 \\u06A9\\u0627\\u0644\\u0627) \\u0648 \\u0628\\u06CC\\u0634 \\u0627\\u0632 \\u06F4\\u06F0 \\u062F\\u0631\\u0635\\u062F \\u06A9\\u0627\\u0644\\u0627\\u0647\\u0627 \\u062F\\u0631 \\u0628\\u0627\\u0632\\u0647 \\u06F7 \\u0631\\u0648\\u0632\\u0647 \\u0645\\u0646\\u062A\\u0647\\u06CC \\u0628\\u0647 \\u06F3 \\u0631\\u0648\\u0632 \\u0627\\u062E\\u06CC\\u0631: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0647\\u0641\\u062A\\u0647 \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645 \\u0644\\u063A\\u0648 \\u0633\\u0641\\u0627\\u0631\\u0634 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F2 \\u06A9\\u0627\\u0644\\u0627) \\u0648 \\u0628\\u06CC\\u0634 \\u0627\\u0632 \\u06F4\\u06F0 \\u062F\\u0631\\u0635\\u062F \\u06A9\\u0627\\u0644\\u0627\\u0647\\u0627 \\u062F\\u0631 \\u0628\\u0627\\u0632\\u0647 \\u06F7 \\u0631\\u0648\\u0632\\u0647 \\u0645\\u0646\\u062A\\u0647\\u06CC \\u0628\\u0647 \\u06F3 \\u0631\\u0648\\u0632 \\u0627\\u062E\\u06CC\\u0631: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0644\\u063A\\u0648 \\u0633\\u0641\\u0627\\u0631\\u0634 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0 \\u06A9\\u0627\\u0644\\u0627) \\u0648 \\u0628\\u06CC\\u0634 \\u0627\\u0632 \\u06F1\\u06F0 \\u062F\\u0631\\u0635\\u062F \\u06A9\\u0627\\u0644\\u0627\\u0647\\u0627 \\u062F\\u0631 \\u0628\\u0627\\u0632\\u0647 \\u06F2\\u06F8 \\u0631\\u0648\\u0632\\u0647 \\u0645\\u0646\\u062A\\u0647\\u06CC \\u0628\\u0647 \\u06F1\\u06F4 \\u0631\\u0648\\u0632 \\u0627\\u062E\\u06CC\\u0631: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0628\\u0631\\u0627\\u06CC \\u062D\\u062F\\u0627\\u0642\\u0644 \\u062F\\u0648 \\u0647\\u0641\\u062A\\u0647 \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC: \\u0644\\u063A\\u0648 \\u0633\\u0641\\u0627\\u0631\\u0634 \\u0627\\u0632 \\u0633\\u0648\\u06CC \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u0647: \\u062A\\u0627 \\u06F2 \\u0633\\u0627\\u0639\\u062A \\u0628\\u0639\\u062F \\u0627\\u0632 \\u0646\\u0647\\u0627\\u06CC\\u06CC \\u0634\\u062F\\u0646 \\u0633\\u0641\\u0627\\u0631\\u0634: \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\u0636\\u0631\\u0628 \\u062F\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0633\\u0641\\u0627\\u0631\\u0634\\u200C\\u06AF\\u0630\\u0627\\u0631\\u06CC\\u200C\\u0634\\u062F\\u0647 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646) \\u062A\\u0627 \\u06F2\\u06F4 \\u0633\\u0627\\u0639\\u062A \\u0628\\u0639\\u062F \\u0627\\u0632 \\u0646\\u0647\\u0627\\u06CC\\u06CC \\u0634\\u062F\\u0646 \\u0633\\u0641\\u0627\\u0631\\u0634: \\u06F2 \\u0628\\u0631\\u0627\\u0628\\u0631 \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\u0636\\u0631\\u0628 \\u062F\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0633\\u0641\\u0627\\u0631\\u0634\\u200C\\u06AF\\u0630\\u0627\\u0631\\u06CC\\u200C\\u0634\\u062F\\u0647 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646) \\u067E\\u0633 \\u0627\\u0632 \\u06F2\\u06F4 \\u0633\\u0627\\u0639\\u062A \\u0627\\u0632 \\u0646\\u0647\\u0627\\u06CC\\u06CC \\u0634\\u062F\\u0646 \\u0633\\u0641\\u0627\\u0631\\u0634: \\u06F3 \\u0628\\u0631\\u0627\\u0628\\u0631 \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\u0636\\u0631\\u0628 \\u062F\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0633\\u0641\\u0627\\u0631\\u0634\\u200C\\u06AF\\u0630\\u0627\\u0631\\u06CC\\u200C\\u0634\\u062F\\u0647 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646) \\u0644\\u063A\\u0648 \\u0627\\u062A\\u0648\\u0645\\u0627\\u062A\\u06CC\\u06A9 \\u0628\\u0647 \\u062F\\u0644\\u06CC\\u0644 \\u0639\\u062F\\u0645 \\u0627\\u0631\\u0633\\u0627\\u0644 \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 \\u062A\\u0627 \\u0632\\u0645\\u0627\\u0646 \\u062A\\u0639\\u0647\\u062F \\u062A\\u062D\\u0648\\u06CC\\u0644: \\u06F5 \\u0628\\u0631\\u0627\\u0628\\u0631 \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\u0636\\u0631\\u0628 \\u062F\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0633\\u0641\\u0627\\u0631\\u0634\\u200C\\u06AF\\u0630\\u0627\\u0631\\u06CC\\u200C\\u0634\\u062F\\u0647 (\\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646)\",isNew:!0},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u0623\\u062E\\u06CC\\u0631 \\u062F\\u0631 \\u062A\\u0623\\u0645\\u06CC\\u0646 \\u06A9\\u0627\\u0644\\u0627\",content:'<div style=\"direction: rtl; font-family: sans-serif;\">\\n    <p class=\\'align-center my-4\\'>\\n    \\n    \\u0641\\u0631\\u0645\\u0648\\u0644 \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u0623\\u062E\\u06CC\\u0631 = \\u0645\\u0628\\u0644\\u063A \\u0641\\u0631\\u0648\\u0634 \\xd7 \\u06A9\\u0645\\u06CC\\u0633\\u06CC\\u0648\\u0646 \\u0641\\u0631\\u0648\\u0634 \\xd7 \\u0636\\u0631\\u06CC\\u0628 \\u0631\\u0648\\u0632 \\u062A\\u0623\\u062E\\u06CC\\u0631 \\xd7 \\u062A\\u0639\\u062F\\u0627\\u062F \\u062A\\u0623\\u0645\\u06CC\\u0646\\u200C\\u0646\\u0634\\u062F\\u0647 \\n    </p>\\n    <div class=\"d-flex ai-center flex-1 gap-x-6\">\\n    <table border=\"1\" cellspacing=\"0\" cellpadding=\"8\" style=\"border-collapse: collapse; width: 50%;margin: 0 auto; text-align: center;\">\\n      <thead>\\n        <tr style=\"background-color: #dbe8f5; font-weight: bold;\">\\n          <th style=\"width: 50%;\">\\u0631\\u0648\\u0632 \\u062A\\u0623\\u062E\\u06CC\\u0631</th>\\n          <th style=\"width: 50%;\">\\u0636\\u0631\\u06CC\\u0628 \\u062A\\u0623\\u062E\\u06CC\\u0631</th>\\n        </tr>\\n      </thead>\\n      <tbody>\\n        <tr>\\n          <td>\\u0631\\u0648\\u0632 \\u0627\\u0648\\u0644</td>\\n          <td>\\u06F0.\\u06F3</td>\\n        </tr>\\n        <tr>\\n          <td>\\u0631\\u0648\\u0632 \\u062F\\u0648\\u0645</td>\\n          <td>\\u06F1</td>\\n        </tr>\\n        <tr>\\n          <td>\\u0631\\u0648\\u0632 \\u0633\\u0648\\u0645</td>\\n          <td>\\u06F0.\\u06F6</td>\\n        </tr>\\n        <tr>\\n          <td>\\u0686\\u0647\\u0627\\u0631 \\u0631\\u0648\\u0632 \\u0648 \\u0628\\u06CC\\u0634\\u062A\\u0631</td>\\n          <td>\\u06F0.\\u06F3</td>\\n        </tr>\\n      </tbody>\\n    </table>\\n\\n    <div style=\"width: 50%;\">\\n        <p><strong>\\u0645\\u062B\\u0627\\u0644:</strong></p>\\n        <ul style=\"margin: 8px 0; padding-right: 24px; direction: rtl;\">\\n          <li>&#8226; \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627: \\u06F1\\u066C\\u06F0\\u06F0\\u06F0\\u066C\\u06F0\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646</li>\\n          <li>&#8226; \\u062F\\u0631\\u0635\\u062F \\u06A9\\u0645\\u06CC\\u0633\\u06C