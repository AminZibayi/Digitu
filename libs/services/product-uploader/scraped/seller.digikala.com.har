46 \\u063a\\u06cc\\u0631\\u0627\\u0635\\u0644\",\"content\":\"\\u003Cp\\u003E\\u0627\\u0635\\u0627\\u0644\\u062a \\u06a9\\u0627\\u0644\\u0627 (\\u0646\\u0634\\u0627\\u0646 \\u063a\\u06cc\\u0631 \\u0627\\u0635\\u0644): \\u0627\\u06af\\u0631 \\u0631\\u0648\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0628\\u0631\\u0646\\u062f\\u06cc \\u0648\\u062c\\u0648\\u062f \\u062f\\u0627\\u0631\\u062f \\u06a9\\u0647 \\u0622\\u0646 \\u0645\\u062d\\u0635\\u0648\\u0644 \\u062a\\u0648\\u0633\\u0637 \\u0622\\u0646 \\u0628\\u0631\\u0646\\u062f \\u062a\\u0648\\u0644\\u06cc\\u062f \\u0646\\u0634\\u062f\\u0647 \\u0627\\u0633\\u062a\\u060c \\u0628\\u0627\\u06cc\\u062f \\u0627\\u0632 \\u0646\\u0634\\u0627\\u0646 \\u063a\\u06cc\\u0631 \\u0627\\u0635\\u0644 \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u0647 \\u06a9\\u0646\\u06cc\\u062f. \\u0627\\u06af\\u0631\\u0631\\u0648\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0647\\u06cc\\u0686 \\u0628\\u0631\\u0646\\u062f\\u06cc \\u0648\\u062c\\u0648\\u062f \\u0646\\u062f\\u0627\\u0631\\u062f\\u060c \\u0646\\u0628\\u0627\\u06cc\\u062f \\u0627\\u0632 \\u0646\\u0634\\u0627\\u0646 \\u063a\\u06cc\\u0631 \\u0627\\u0635\\u0644 \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u0647 \\u06a9\\u0631\\u062f \\u0648 \\u0645\\u062d\\u0635\\u0648\\u0644 \\u0631\\u0627 \\u0628\\u0627 \\u0628\\u0631\\u0646\\u062f \\u0645\\u062a\\u0641\\u0631\\u0642\\u0647 \\u062f\\u0631\\u062c \\u06a9\\u0646\\u06cc\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n1- \\u0627\\u06af\\u0631 \\u0645\\u062d\\u0635\\u0648\\u0644 \\u063a\\u06cc\\u0631\\u0627\\u0635\\u0644 \\u0627\\u0633\\u062a \\u0648 \\u0627\\u0632 \\u0646\\u0634\\u0627\\u0646 \\u063a\\u06cc\\u0631 \\u0627\\u0635\\u0644 \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u0647 \\u0645\\u06cc\\u0026zwnj;\\u06a9\\u0646\\u06cc\\u062f\\u060c \\u0646\\u0628\\u0627\\u06cc\\u062f \\u0647\\u06cc\\u0686 \\u0628\\u0631\\u0646\\u062f\\u06cc \\u062f\\u0631 \\u0639\\u0646\\u0648\\u0627\\u0646 \\u06a9\\u0627\\u0644\\u0627 \\u0630\\u06a9\\u0631 \\u0634\