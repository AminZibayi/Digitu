0627\\u0644\\u0627\\u06cc\\u06cc \\u0627\\u0633\\u062a \\u06a9\\u0647 \\u0642\\u0635\\u062f \\u0641\\u0631\\u0648\\u0634 \\u0622\\u0646 \\u0631\\u0627 \\u062f\\u0627\\u0631\\u06cc\\u062f. \\u0628\\u0631\\u0646\\u062f \\u0645\\u0648\\u0631\\u062f \\u0646\\u0638\\u0631 \\u0634\\u0645\\u0627 \\u0628\\u0627\\u06cc\\u062f \\u062f\\u0631 \\u0647\\u0645\\u0627\\u0646 \\u06af\\u0631\\u0648\\u0647 \\u06a9\\u0627\\u0644\\u0627\\u06cc\\u06cc \\u06a9\\u0647 \\u0642\\u0635\\u062f \\u062f\\u0631\\u062c \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u062f\\u0627\\u0631\\u06cc\\u062f\\u060c \\u062b\\u0628\\u062a \\u0634\\u062f\\u0647 \\u0628\\u0627\\u0634\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u0627\\u06af\\u0631 \\u0628\\u0631\\u0646\\u062f\\u06cc \\u0628\\u0631\\u0627\\u06cc \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u062e\\u0648\\u062f \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u0645\\u06cc \\u06a9\\u0646\\u06cc\\u062f\\u060c \\u0622\\u0646 \\u0628\\u0631\\u0646\\u062f \\u0628\\u0627\\u06cc\\u062f \\u0631\\u0648\\u06cc \\u062d\\u062f\\u0627\\u0642\\u0644 \\u06cc\\u06a9\\u06cc \\u0627\\u0632 \\u062a\\u0635\\u0627\\u0648\\u06cc\\u0631 \\u06a9\\u0627\\u0644\\u0627 \\u062f\\u0631\\u062a\\u0635\\u0627\\u0648\\u06cc\\u0631\\u0622\\u0644\\u0628\\u0648\\u0645 \\u0648\\u062c\\u0648\\u062f \\u062f\\u0627\\u0634\\u062a\\u0647 \\u0628\\u0627\\u0634\\u062f\\u060c \\u0686\\u0646\\u0627\\u0646\\u0686\\u0647 \\u062f\\u0631 \\u062a\\u0635\\u0627\\u0648\\u06cc\\u0631 \\u06a9\\u0627\\u0644\\u0627 \\u0628\\u0631\\u0646\\u062f \\u062f\\u06cc\\u062f\\u0647 \\u0646\\u0634\\u0648\\u062f \\u0648 \\u0634\\u0645\\u0627 \\u062f\\u0631 \\u0641\\u06cc\\u0644\\u062f \\u0628\\u0631\\u0646\\u062f\\u060c \\u0628\\u0631\\u0646\\u062f\\u06cc \\u0628\\u0631\\u0627\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0631\\u062f\\u0647 \\u0628\\u0627\\u0634\\u06cc\\u062f\\u060c \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u062f \\u0645\\u06cc \\u0634\\u0648\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u0627\\u06af\\u0631 \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u062a\\u0648\\u0644\\u06cc\\u062f \\u0634\\u062f\\u0647 \\u062a\\u0648\\u0633\\u0637 \\u0628\\u0631\\u0646\\u062f \\u0627\\u0635\\u0644\\u06cc \\u0627\\u0633\\u062a\\u060c \\u0628\\u0627\\u06cc\\u062f \\u0628\\u0631\\u0646\\u062f \\u0645\\u062d\\u0635\\u0648\\u0644 \\u0631\\u0627 \\u062f\\u0631 \\u0641\\u06cc\\u0644\\u062f \\u0628\\u0631\\u0646\\u062f \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0646\\u06cc\\u062f \\u0627\\u06af\\u0631 \\u0628\\u0631\\u0646\\u062f \\u0634\\u0645\\u0627 \\u062f\\u0631 \\u0644\\u06cc\\u0633\\u062a \\u0628\\u0631\\u0646\\u062f\\u0647\\u0627\\u06cc \\u0645\\u0648\\u062c\\u0648\\u062f \\u0646\\u0628\\u0648\\u062f \\u06af\\u0632\\u06cc\\u0646\\u0647 \\u062f\\u0631\\u062e\\u0648\\u0627\\u0633\\u062a \\u0627\\u06cc\\u062c\\u0627\\u062f \\u0628\\u0631\\u0646\\u062f \\u062c\\u062f\\u06cc\\u062f \\u0631\\u0627 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0646\\u06cc\\u062f \\u0648 \\u0627\\u0642\\u062f\\u0627\\u0645 \\u0628\\u0647 \\u062b\\u0628\\u062a \\u0628\\u0631\\u0646\\u062f \\u062e\\u0648\\u062f \\u06a9\\u0646\\u06cc\\u062f. \\u0622\\u0645\\u0648\\u0632\\u0634 \\u062f\\u0631\\u062e\\u0648\\u0627\\u0633\\u062a \\u0628\\u0631\\u0646\\u062f \\u062c\\u062f\\u06cc\\u062f \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u003Ca href=\\u0022https:\\/\\/selleracademy.digikala.com\\/%D8%AF%D8%B1%D8%AE%D9%88%D8%A7%D8%B3%D8%AA-%D8%A7%DB%8C%D8%AC%D8%A7%D8%AF-%D8%A8%D8%B1%D9%86%D8%AF\\/\\u0022 target=\\u0022_blank\\u0022\\u003E\\u0644\\u06cc\\u0646\\u06a9\\u003C\\/a\\u003E \\u0645\\u0648\\u062c\\u0648\\u062f \\u0627\\u0633\\u062a.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u0627\\u06af\\u0631 \\u0631\\u0648\\u06cc \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u0647\\u06cc\\u0686 \\u0628\\u0631\\u0646\\u062f\\u06cc \\u0648\\u062c\\u0648\\u062f \\u0646\\u062f\\u0627\\u0631\\u062f\\u060c \\u0628\\u0627\\u06cc\\u062f \\u0628\\u0631\\u0646\\u062f \\u0026quot;\\u0645\\u062a\\u0641\\u0631\\u0642\\u0647\\u0026quot; \\u0631\\u0627 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0646\\u06cc\\u062f.\\u003C\\/p\\u003E\"},{\"title\":\"\\u0646\\u0648\\u0639 \\u06a9\\u0627\\u0644\\u0627\",\"content\":\"\\u003Cp\\u003E\\u062f\\u0631 \\u0647\\u0646\\u06af\\u0627\\u0645 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u0646\\u0648\\u0639 \\u06a9\\u0627\\u0644\\u0627 \\u062a\\u0646\\u0647\\u0627 \\u0645\\u0648\\u0627\\u0631\\u062f\\u06cc \\u0631\\u0648 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0646\\u06cc\\u062f \\u06a9\\u0647 \\u0628\\u0647 \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u0645\\u0631\\u0628\\u0648\\u0637 \\u0627\\u0633\\u062a. \\u0627\\u06af\\u0631 \\u0645\\u0648\\u0627\\u0631\\u062f \\u0628\\u06cc \\u0631\\u0628\\u0637 \\u0628\\u0647 \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u0627\\u0646\\u062a\\u062e\\u0627\\u0628 \\u06a9\\u0646\\u06cc\\u062f \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u062f \\u0645\\u06cc \\u0634\\u0648\\u062f.\\u003C\\/p\\u003E\"},{\"title\":\"\\u0645\\u062f\\u0644 \\u06a9\\u0627\\u0644\\u0627\",\"content\":\"\\u003Cp\\u003E\\u0627\\u0632 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u062f\\u0631 \\u0633\\u06cc\\u0633\\u062a\\u0645 \\u0646\\u0627\\u0645\\u06af\\u0630\\u0627\\u0631\\u06cc \\u062e\\u0648\\u062f\\u06a9\\u0627\\u0631 \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u0647 \\u0645\\u06cc \\u0634\\u0648\\u062f.\\u062d\\u062a\\u0645\\u0627 \\u062f\\u0642\\u062a \\u06a9\\u0646\\u06cc\\u062f \\u0627\\u06af\\u0631 \\u0631\\u0648\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u06cc\\u0627 \\u0628\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u0645\\u062f\\u0644\\u06cc \\u0648\\u062c\\u0648\\u062f \\u062f\\u0627\\u0631\\u062f\\u060c \\u0628\\u0627\\u06cc\\u062f \\u062f\\u0642\\u06cc\\u0642\\u0627 \\u0647\\u0645\\u0627\\u0646 \\u0645\\u062f\\u0644 \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u0648 \\u0639\\u0646\\u0648\\u0627\\u0646 \\u06a9\\u0627\\u0644\\u0627 \\u0646\\u0648\\u0634\\u062a\\u0647 \\u0634\\u0648\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u0644\\u0637\\u0641\\u0627 \\u062a\\u0648\\u062c\\u0647 \\u06a9\\u0646\\u06cc\\u062f \\u0627\\u06af\\u0631 \\u0645\\u0648\\u0627\\u0631\\u062f \\u0632\\u06cc\\u0631 \\u0631\\u0627 \\u062f\\u0631 \\u0642\\u0633\\u0645\\u062a \\u0645\\u062f\\u0644 \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0639\\u0627\\u06cc\\u062a \\u0646\\u06a9\\u0646\\u06cc\\u062f \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u0631\\u062f \\u0645\\u06cc \\u0634\\u0648\\u062f:\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n1- \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u0628\\u0647 \\u0647\\u06cc\\u0686 \\u0639\\u0646\\u0648\\u0627\\u0646 \\u06a9\\u0644\\u0645\\u0647 \\u0026quot;\\u0645\\u062f\\u0644\\u0026quot; \\u0631\\u0627 \\u0646\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f. (\\u06a9\\u0644\\u0645\\u0647 \\u0645\\u062f\\u0644 \\u062f\\u0631 \\u0639\\u0646\\u0648\\u0627\\u0646 \\u067e\\u06cc\\u0634\\u0646\\u0647\\u0627\\u062f\\u06cc \\u0628\\u0647 \\u0635\\u0648\\u0631\\u062a \\u062e\\u0648\\u062f\\u06a9\\u0627\\u0631 \\u0627\\u0636\\u0627\\u0641\\u0647 \\u062e\\u0648\\u0627\\u0647\\u062f \\u0634\\u062f)\\u003Cbr \\/\\u003E\\r\\n2- \\u0627\\u06af\\u0631 \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u062f\\u0627\\u0631\\u0627\\u06cc \\u0645\\u062f\\u0644\\u060c \\u06a9\\u062f \\u0648 \\u0633\\u0631\\u06cc \\u0628\\u0648\\u062f \\u0627\\u0628\\u062a\\u062f\\u0627 \\u062a\\u0646\\u0647\\u0627 \\u0645\\u062f\\u0644 \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f \\u0648 \\u0633\\u067e\\u0633 \\u0628\\u0627 \\u0630\\u06a9\\u0631 \\u06a9\\u0644\\u0645\\u0627\\u062a \\u06a9\\u062f \\u0648 \\u0633\\u0631\\u06cc\\u060c \\u06a9\\u062f \\u0648 \\u0633\\u0631\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u0645\\u062b\\u0627\\u0644:\\u003Cbr \\/\\u003E\\r\\n\\u0639\\u0646\\u0648\\u0627\\u0646 \\u06a9\\u0627\\u0644\\u0627:\\u003Cbr \\/\\u003E\\r\\n\\u0639\\u06cc\\u0646\\u06a9 \\u0622\\u0641\\u062a\\u0627\\u0628\\u06cc \\u0631\\u06cc \\u0628\\u0646 \\u0645\\u062f\\u0644 01 \\u06a9\\u062f 02 \\u0633\\u0631\\u06cc 03\\u003Cbr \\/\\u003E\\r\\n\\u0686\\u06cc\\u0632\\u06cc \\u06a9\\u0647 \\u0628\\u0627\\u06cc\\u062f \\u062f\\u0631 \\u0642\\u0633\\u0645\\u062a \\u0645\\u062f\\u0644 \\u0648\\u0627\\u0631\\u062f \\u06a9\\u0646\\u06cc\\u062f:\\u003Cbr \\/\\u003E\\r\\n01 \\u06a9\\u062f 02 \\u0633\\u0631\\u06cc 03\\u003Cbr \\/\\u003E\\r\\n\\u0026nbsp;\\u003C\\/p\\u003E\"},{\"title\":\"\\u062f\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u06a9\\u0627\\u0644\\u0627\",\"content\":\"\\u003Cp\\u003E\\u062f\\u0631 \\u06af\\u0627\\u0645 \\u062f\\u0648\\u0645 \\u062f\\u0631\\u062c \\u06a9\\u0627\\u0644\\u0627\\u060c \\u0642\\u0633\\u0645\\u062a \\u062f\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u0645\\u0631\\u0628\\u0648\\u0637 \\u0628\\u0647 \\u0645\\u0627\\u0647\\u06cc\\u062a \\u06a9\\u0627\\u0644\\u0627 \\u062f\\u0631 \\u0639\\u0646\\u0648\\u0627\\u0646 \\u06a9\\u0627\\u0644\\u0627 \\u0627\\u0633\\u062a.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u0627\\u06af\\u0631 \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u0645\\u0627\\u0647\\u06cc\\u062a \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u062e\\u0648\\u062f \\u0631\\u0627 \\u067e\\u06cc\\u062f\\u0627 \\u0646\\u06a9\\u0631\\u062f\\u06cc\\u062f\\u060c \\u062f\\u0631\\u062e\\u0648\\u0627\\u0633\\u062a \\u0627\\u0636\\u0627\\u0641\\u0647 \\u0634\\u062f\\u0646 \\u0627\\u06cc\\u0646 \\u062f\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u0631\\u0627 \\u0628\\u0627 \\u062b\\u0628\\u062a \\u062a\\u06cc\\u06a9\\u062a \\u0627\\u0632 \\u0637\\u0631\\u06cc\\u0642 \\u0641\\u0631\\u0645 \\u0026quot;\\u062a\\u0645\\u0627\\u0633 \\u0628\\u0627 \\u0645\\u0627\\u0026quot; \\u0628\\u0631\\u0627\\u06cc \\u0648\\u0627\\u062d\\u062f LQA \\u0627\\u0631\\u0633\\u0627\\u0644 \\u06a9\\u0646\\u06cc\\u062f.\\u003C\\/p\\u003E\"},{\"title\":\"\\u0627\\u0628\\u0639\\u0627\\u062f \\u0648 \\u0648\\u0632\\u0646 \\u0628\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc\",\"content\":\"\\u003Cp\\u003E\\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u0634\\u0645\\u0627 \\u0628\\u0627\\u06cc\\u062f \\u0627\\u0628\\u0639\\u0627\\u062f \\u0628\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u06a9\\u0647 \\u0642\\u0631\\u0627\\u0631 \\u0627\\u0633\\u062a \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 \\u0627\\u0631\\u0633\\u0627\\u0644 \\u0634\\u0648\\u062f\\u060c \\u0628\\u0647 \\u0633\\u0627\\u0646\\u062a\\u06cc \\u0645\\u062a\\u0631 \\u0648 \\u0647\\u0645\\u0686\\u0646\\u06cc\\u0646 \\u0648\\u0632\\u0646 \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0627 \\u0628\\u0627\\u06cc\\u062f \\u0628\\u0647 \\u06af\\u0631\\u0645 \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u0627\\u0628\\u0639\\u0627\\u062f \\u0648 \\u0648\\u0632\\u0646 \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a\\u060c \\u0631\\u0648\\u06cc \\u0633\\u0627\\u06cc\\u062a \\u0646\\u0645\\u0627\\u06cc\\u0634 \\u062f\\u0627\\u062f\\u0647 \\u0646\\u0645\\u06cc \\u0634\\u0648\\u062f \\u0648 \\u062a\\u0646\\u0647\\u0627 \\u0628\\u0631\\u0627\\u06cc \\u0627\\u0646\\u0628\\u0627\\u0631 \\u0642\\u0627\\u0628\\u0644 \\u0645\\u0634\\u0627\\u0647\\u062f\\u0647 \\u0627\\u0633\\u062a.\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n\\u062d\\u062a\\u0645\\u0627 \\u062f\\u0642\\u062a \\u06a9\\u0646\\u06cc\\u062f \\u06a9\\u0647 \\u0627\\u0628\\u0639\\u0627\\u062f \\u0648 \\u0648\\u0632\\u0646 \\u0628\\u0633\\u062a\\u0647 \\u0628\\u0646\\u062f\\u06cc \\u0631\\u0627 \\u0628\\u0647 \\u062f\\u0631\\u0633\\u062a\\u06cc \\u0648\\u0627\\u0631\\u062f \\u06a9\\u0646\\u06cc\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u0026nbsp;\\u003C\\/p\\u003E\"},{\"title\":\"\\u0634\\u0631\\u062d \\u06a9\\u0627\\u0644\\u0627\",\"content\":\"\\u003Cp\\u003E\\u0627\\u06af\\u0631 \\u062a\\u0645\\u0627\\u06cc\\u0644\\u06cc \\u0646\\u062f\\u0627\\u0631\\u06cc\\u062f \\u0628\\u0631\\u0627\\u06cc \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u062e\\u0648\\u062f \\u0634\\u0631\\u062d \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f \\u062f\\u0631 \\u0627\\u06cc\\u0646 \\u0642\\u0633\\u0645\\u062a \\u0627\\u0635\\u0644\\u0627 \\u0686\\u06cc\\u0632\\u06cc \\u0646\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f. \\u0627\\u0645\\u0627 \\u0627\\u06af\\u0631 \\u0642\\u0635\\u062f \\u062f\\u0627\\u0631\\u06cc\\u062f \\u0628\\u0631\\u0627\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0634\\u0631\\u062d \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f \\u0628\\u0627\\u06cc\\u062f \\u0646\\u06a9\\u0627\\u062a \\u0632\\u06cc\\u0631 \\u0631\\u0627 \\u0631\\u0639\\u0627\\u06cc\\u062a \\u06a9\\u0646\\u06cc\\u062f\\u060c \\u062f\\u0631 \\u063a\\u06cc\\u0631 \\u0627\\u06cc\\u0646 \\u0635\\u0648\\u0631\\u062a \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u0631\\u062f \\u062e\\u0648\\u0627\\u0647\\u062f \\u0634\\u062f.\\u003Cbr \\/\\u003E\\r\\n\\u0644\\u0637\\u0641\\u0627 \\u062a\\u0648\\u062c\\u0647 \\u06a9\\u0646\\u06cc\\u062f \\u0627\\u06af\\u0631 \\u0645\\u0648\\u0627\\u0631\\u062f \\u0632\\u06cc\\u0631 \\u0631\\u0627 \\u062f\\u0631\\u0634\\u0631\\u062d \\u06a9\\u0627\\u0644\\u0627 \\u0631\\u0639\\u0627\\u06cc\\u062a \\u0646\\u06a9\\u0646\\u06cc\\u062f \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u0634\\u0645\\u0627 \\u0631\\u062f \\u0645\\u06cc \\u0634\\u0648\\u062f:\\u003Cbr \\/\\u003E\\r\\n\\u003Cbr \\/\\u003E\\r\\n1- \\u062f\\u0631 \\u0634\\u0631\\u062d \\u06a9\\u0627\\u0644\\u0627 \\u0646\\u0628\\u0627\\u06cc\\u062f \\u0646\\u0627\\u0645 \\u0641\\u0631\\u0648\\u0634\\u06af\\u0627\\u0647\\u060c \\u0642\\u06cc\\u0645\\u062a\\u060c \\u06af\\u0627\\u0631\\u0627\\u0646\\u062a\\u06cc\\u060c \\u0636\\u0645\\u0627\\u0646\\u062a \\u0646\\u0627\\u0645\\u0647 \\u0648 \\u0646\\u0627\\u0645 \\u0628\\u0631\\u0646\\u062f \\u0646\\u0627\\u0645\\u0631\\u062a\\u0628\\u0637 \\u0628\\u0647 \\u06a9\\u0627\\u0644\\u0627\\u06cc \\u062e\\u0648\\u062f \\u0631\\u0627 \\u0628\\u0646\\u0648\\u06cc\\u0633\\u06cc\\u062f.\\u003Cbr \\/\\u003E\\r\\n2- \\u0627\\u0645\\u0644\\u0627 \\u0648 \\u0646\\u06af\\u0627\\u0631\\u0634 \\u06a9\\u0644\\u0645\\u0627\\u062a \\u0628\\u0627\\u06cc\\u062f \\u0635\\u062d\\u06cc\\u062d \\u0628\\u0627\\u0634\\u062f \\u0648 \\u0647\\u06cc\\u0686 \\u063a\\u0644\\u0637 \\u0627\\u0645\\u0644\\u0627\\u06cc\\u06cc \\u062f\\u0631 \\u0622\\u0646 \\u0648\\u062c\\u0648\\u062f \\u0646\\u062f\\u0627\\u0634\\u062a\\u0647 \\u0628\\u0627\\u0634\\u062f.\\u003Cbr \\/\\u003E\\r\\n3- \\u0627\\u0637\\u0644\\u0627\\u0639\\u0627\\u062a \\u0645\\u0648\\u062c\\u0648\\u062f \\u062f\\u0631 \\u0634\\u0631\\u062d \\u06a9\\u0627\\u0644\\u0627 \\u0646\\u0628\\u0627\\u06cc\\u062f \\u0628\\u0627 \\u0645\\u0634\\u062e\\u0635\\u0627\\u062a \\u0648 \\u0648\\u06cc\\u0698\\u06af\\u06cc\\u0026zwnj;\\u0647\\u0627\\u06cc \\u06a9\\u0627\\u0644\\u0627 \\u0645\\u063a\\u0627\\u06cc\\u0631\\u062a \\u062f\\u0627\\u0634\\u062a\\u0647 \\u0628\\u0627\\u0634\\u062f.\\u003Cbr \\/\\u003E\\r\\n4- \\u062f\\u0631 \\u0634\\u0631\\u062d \\u0646\\u0648\\u06cc\\u0633\\u06cc \\u0628\\u0627\\u06cc\\u062f \\u0627\\u0632 \\u062c\\u0645\\u0644\\u0627\\u062a \\u067e\\u06cc\\u0648\\u0633\\u062a\\u0647 \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u0647 \\u06a9\\u0646\\u06cc\\u062f \\u0648 \\u0627\\u06af\\u0631 \\u0627\\u0632 \\u0639\\u0628\\u0627\\u0631\\u062a \\u0647\\u0627\\u06cc \\u06a9\\u0648\\u062a\\u0627\\u0647 \\u062f\\u0631 \\u0647\\u0631 \\u0633\\u0637\\u0631 \\u0628\\u0627 \\u0639\\u0644\\u0627\\u0645\\u062a \\u06af\\u0630\\u0627\\u0631\\u06cc (\\u0634\\u0645\\u0627\\u0631\\u0647\\u060c \\u0646\\u0642\\u0637\\u0647\\u060c\\u062e\\u0637 \\u0641\\u0627\\u0635\\u0644\\u0647) \\u0627\\u0633\\u062a\\u0641\\u0627\\u062f\\u