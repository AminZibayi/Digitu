67E\\u0646\\u062C\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0645\\u0627\\u0647\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634 \".concat(o(\"\\u06A9\\u0627\\u0644\\u0627\\u06CC \\u063A\\u06CC\\u0631\\u0627\\u0635\\u0644\",\"https://selleracademy.digikala.com/%d9%81%d8%b1%d9%88%d8%b4-%da%a9%d8%a7%d9%84%d8%a7%db%8c-%d8%ba%db%8c%d8%b1%d8%a7%d8%b5%d9%84-%d8%af%d8%b1-%d8%af%db%8c%d8%ac%db%8c%da%a9%d8%a7%d9%84%d8%a7/\"),\" \"),content:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u0647\\u0645\\u06CC\\u0634\\u06AF\\u06CC \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0622\\u0646 \\u06A9\\u0627\\u0644\\u0627 \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC + \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC + \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u0628\\u0631\\u0627\\u0628\\u0631 \\u0627\\u0633\\u062A \\u0628\\u0627 \\u06F1\\u06F0 \\u0628\\u0631\\u0627\\u0628\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u063A\\u06CC\\u0631\\u200C\\u200C\\u0627\\u0635\\u0644 \\u0641\\u0631\\u0648\\u062E\\u062A\\u0647\\u200C\\u0634\\u062F\\u0647 \\u0636\\u0631\\u0628 \\u062F