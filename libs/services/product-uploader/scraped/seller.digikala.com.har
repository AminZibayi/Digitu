u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC + \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC + \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u0628\\u0631\\u0627\\u0628\\u0631 \\u0627\\u0633\\u062A \\u0628\\u0627 \\u06F1\\u06F0 \\u0628\\u0631\\u0627\\u0628\\u0631 \\u0642\\u06CC\\u0645\\u062A \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u063A\\u06CC\\u0631\\u200C\\u200C\\u0627\\u0635\\u0644 \\u0641\\u0631\\u0648\\u062E\\u062A\\u0647\\u200C\\u0634\\u062F\\u0647 \\u0636\\u0631\\u0628 \\u062F\\u0631 \\u062A\\u0639\\u062F\\u0627\\u062F \\u06A9\\u0644 \\u0641\\u0631\\u0648\\u062E\\u062A\\u0647\\u200C\\u0634\\u062F\\u0647 \\u0627\\u0632 \\u0622\\u0646 \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u063A\\u06CC\\u0631\\u200C\\u0627\\u0635\\u0644 \\u0627\\u0632 \\u0627\\u0628\\u062A\\u062F\\u0627 \\u062D\\u062F\\u0627\\u0642\\u0644 \\u0648 \\u062D\\u062F\\u0627\\u06A9\\u062B\\u0631 \\u0645\\u06CC\\u0632\\u0627\\u0646 \\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0646\\u0642\\u062F\\u06CC \\u062F\\u0631 \\u0647\\u0631 \\u0628\\u0627\\u0631 \\u062A\\u062E\\u0644\\u0641: \\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F5 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646 \\u0648 \\u062D\\u062F\\u0627\\u06A9\\u062B\\u0631 \\u06F5\\u06F0 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646 \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F0 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646 \\u0648 \\u062D\\u062F\\u0627\\u06A9\\u062B\\u0631 \\u06F1\\u06F0\\u06F0 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646 \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u062D\\u062F\\u0627\\u0642\\u0644 \\u06F1\\u06F5 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646 \\u0648 \\u062D\\u062F\\u0627\\u06A9\\u062B\\u0631 \\u06F1\\u06F5\\u06F0 \\u0645\\u06CC\\u0644\\u06CC\\u0648\\u0646 \\u062A\\u0648\\u0645\\u0627\\u0646\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \".concat(o(\"\\u0645\\u063A\\u0627\\u06CC\\u0631\\u062A \\u06A9\\u0627\\u0644\\u0627\",\"https://selleracademy.digikala.com/%d9%87%d9%85%d9%87-%d8%a2%d9%86%da%86%d9%87-%d8%a8%d8%a7%db%8c%d8%af-%d8%af%d8%b1%d8%a8%d8%a7%d8%b1%d9%87-%da%a9%d8%a7%d9%84%d8%a7%db%8c-%d9%85%d8%ba%d8%a7%db%8c%d8%b1-%d8%a8%d8%af%d8%a7%d9%86%db%8c/\"),\" \\u0647\\u0646\\u06AF\\u0627\\u0645 \\u0648\\u0631\\u0648\\u062F \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 (\\u0628\\u0631\\u0646\\u062F\\u060C \\u0645\\u062F\\u0644\\u060C \\u0639\\u0646\\u0648\\u0627\\u0646\\u060C \\u0645\\u0634\\u062E\\u0635\\u0627\\u062A\\u060C \\u062A\\u0635\\u0648\\u06CC\\u0631\\u060C \\u0628\\u0633\\u062A\\u0647\\u200C\\u0628\\u0646\\u062F\\u06CC\\u060C \\u0627\\u0628\\u0639\\u0627\\u062F\\u060C \\u0631\\u0646\\u06AF)\"),content:\"\\u0647\\u0631 \\u06A9\\u0627\\u0644\\u0627 (\\u0633\\u0631\\u06CC\\u0627\\u0644 \\u06A9\\u0627\\u0644\\u0627) \\u06F1\\u06F5\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0645\\u063A\\u0627\\u06CC\\u0631\\u062A \\u06A9\\u0627\\u0644\\u0627 \\u0647\\u0646\\u06AF\\u0627\\u0645 \\u0648\\u0631\\u0648\\u062F \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 (\\u0628\\u0631\\u0646\\u062F\\u060C \\u0645\\u062F\\u0644\\u060C \\u0639\\u0646\\u0648\\u0627\\u0646\\u060C \\u0645\\u0634\\u062E\\u0635\\u0627\\u062A\\u060C \\u062A\\u0635\\u0648\\u06CC\\u0631\\u060C \\u0628\\u0633\\u062A\\u0647\\u200C\\u0628\\u0646\\u062F\\u06CC\\u060C \\u0627\\u0628\\u0639\\u0627\\u062F\\u060C \\u0631\\u0646\\u06AF)\",contentStr:\"\\u0647\\u0631 \\u06A9\\u0627\\u0644\\u0627 (\\u0633\\u0631\\u06CC\\u0627\\u0644 \\u06A9\\u0627\\u0644\\u0627) \\u06F1\\u06F5\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u062D\\u0648\\u06CC\\u0644 \\u0646\\u0627\\u0642\\u0635 \\u0645\\u062D\\u0645\\u0648\\u0644\\u0647 \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 \\u0646\\u0633\\u0628\\u062A \\u0628\\u0647 \\u0686\\u06CC\\u0632\\u06CC \\u06A9\\u0647 \\u062F\\u0631 \\u067E\\u0646\\u0644 \\u062B\\u0628\\u062A \\u0634\\u062F\\u0647\",content:\"\\u0647\\u0631 \\u06A9\\u0627\\u0644\\u0627 (\\u0633\\u0631\\u06CC\\u0627\\u0644 \\u06A9\\u0627\\u0644\\u0627) \\u06F1\\u06F5\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u062D\\u0648\\u06CC\\u0644 \\u0646\\u0627\\u0642\\u0635 \\u0645\\u062D\\u0645\\u0648\\u0644\\u0647 \\u0628\\u0647 \\u0627\\u0646\\u0628\\u0627\\u0631 \\u0646\\u0633\\u0628\\u062A \\u0628\\u0647 \\u0686\\u06CC\\u0632\\u06CC \\u06A9\\u0647 \\u062F\\u0631 \\u067E\\u0646\\u0644 \\u062B\\u0628\\u062A \\u0634\\u062F\\u0647\",contentStr:\"\\u0647\\u0631 \\u06A9\\u0627\\u0644\\u0627 (\\u0633\\u0631\\u06CC\\u0627\\u0644 \\u06A9\\u0627\\u0644\\u0627) \\u06F1\\u06F5\\u06F0\\u06F0 \\u062A\\u0648\\u0645\\u0627\\u0646\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0645\\u063A\\u0627\\u06CC\\u0631 (\\u0628\\u0631 \\u0627\\u0633\\u0627\\u0633 \\u0628\\u0631\\u0631\\u0633\\u06CC \\u06A9\\u0627\\u0631\\u0634\\u0646\\u0627\\u0633\\u0627\\u0646 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627)\",content:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u0633\\u0647 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0686\\u0647\\u0627\\u0631\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627\\u06CC \\u0645\\u063A\\u0627\\u06CC\\u0631 (\\u0628\\u0631 \\u0627\\u0633\\u0627\\u0633 \\u0628\\u0631\\u0631\\u0633\\u06CC \\u06A9\\u0627\\u0631\\u0634\\u0646\\u0627\\u0633\\u0627\\u0646 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627)\",contentStr:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u0633\\u0647 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0686\\u0647\\u0627\\u0631\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0639\\u062F\\u0645 \\u0627\\u0631\\u0633\\u0627\\u0644 \\u06AF\\u0627\\u0631\\u0627\\u0646\\u062A\\u06CC\\u060C \\u0627\\u0631\\u0633\\u0627\\u0644 \\u06AF\\u0627\\u0631\\u0627\\u0646\\u062A\\u06CC \\u0646\\u0627\\u0645\\u0639\\u062A\\u0628\\u0631\\u060C \\u0645\\u063A\\u0627\\u06CC\\u0631 \\u06CC\\u0627 \\u0641\\u0627\\u0642\\u062F \\u0632\\u0645\\u0627\\u0646 \\u0627\\u0639\\u062A\\u0628\\u0627\\u0631 (\\u0627\\u062A\\u0645\\u0627\\u0645 \\u0645\\u062F\\u062A \\u06CC\\u0627 \\u0646\\u0627\\u06A9\\u0627\\u0641\\u06CC\\u200C\\u0628\\u0648\\u062F\\u0646 \\u0645\\u062F\\u062A)\",content:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0686\\u0647\\u0627\\u0631\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0639\\u062F\\u0645 \\u0627\\u0631\\u0633\\u0627\\u0644 \\u06AF\\u0627\\u0631\\u0627\\u0646\\u062A\\u06CC\\u060C \\u0627\\u0631\\u0633\\u0627\\u0644 \\u06AF\\u0627\\u0631\\u0627\\u0646\\u062A\\u06CC \\u0646\\u0627\\u0645\\u0639\\u062A\\u0628\\u0631\\u060C \\u0645\\u063A\\u0627\\u06CC\\u0631 \\u06CC\\u0627 \\u0641\\u0627\\u0642\\u062F \\u0632\\u0645\\u0627\\u0646 \\u0627\\u0639\\u062A\\u0628\\u0627\\u0631 (\\u0627\\u062A\\u0645\\u0627\\u0645 \\u0645\\u062F\\u062A \\u06CC\\u0627 \\u0646\\u0627\\u06A9\\u0627\\u0641\\u06CC\\u200C\\u0628\\u0648\\u062F\\u0646 \\u0645\\u062F\\u062A)\",contentStr:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0631\\u0627\\u06CC \\u06CC\\u06A9 \\u0645\\u0627\\u0647 \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0686\\u0647\\u0627\\u0631\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 \\u0628\\u0627 \\u0645\\u0628\\u062F\\u0627 \\u062E\\u0627\\u0631\\u062C\\u06CC \\u0648 \\u0648\\u0631\\u0648\\u062F \\u063A\\u06CC\\u0631\\u0642\\u0627\\u0646\\u0648\\u0646\\u06CC (\\u0628\\u0631 \\u0627\\u0633\\u0627\\u0633 \\u0628\\u0631\\u0631\\u0633\\u06CC \\u06A9\\u0627\\u0631\\u0634\\u0646\\u0627\\u0633\\u0627\\u0646 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627)\",content:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 \\u0628\\u0627 \\u0645\\u0628\\u062F\\u0627 \\u062E\\u0627\\u0631\\u062C\\u06CC \\u0648 \\u0648\\u0631\\u0648\\u062F \\u063A\\u06CC\\u0631\\u0642\\u0627\\u0646\\u0648\\u0646\\u06CC (\\u0628\\u0631 \\u0627\\u0633\\u0627\\u0633 \\u0628\\u0631\\u0631\\u0633\\u06CC \\u06A9\\u0627\\u0631\\u0634\\u0646\\u0627\\u0633\\u0627\\u0646 \\u062F\\u06CC\\u062C\\u06CC\\u200C\\u06A9\\u0627\\u0644\\u0627)\",contentStr:\"\\u0628\\u0627\\u0631 \\u06CC\\u06A9\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u06A9\\u0627\\u0644\\u0627 (\\u06A9\\u062F \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC) \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u062F\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u0641\\u0631\\u0648\\u0634 \\u0628\\u0631\\u0646\\u062F/\\u06AF\\u0631\\u0648\\u0647 \\u06A9\\u0627\\u0644\\u0627\\u06CC\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC \\u0628\\u0627\\u0631 \\u0633\\u0648\\u0645: \\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\"},{title:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u062E\\u0644\\u0641 \\u0627\\u0646\\u0636\\u0628\\u0627\\u0637\\u06CC\",content:\"\\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0646\\u062F\\u06AF\\u06CC \\u0628\\u0647\\u200C\\u0637\\u0648\\u0631 \\u062F\\u0627\\u0626\\u0645\\u06CC\",titleStr:\"\\u062C\\u0631\\u06CC\\u0645\\u0647 \\u062A\\u062E\\u0644\\u0641 \\u0627\\u0646\\u0636\\u0628\\u0627\\u0637\\u06CC\",contentStr:\"\\u06AF\\u0631\\u0641\\u062A\\u0646 \\u062F\\u0633\\u062A\\u0631\\u0633\\u06CC \\u067E\\u0646\\u0644 \\u0641\\u0631\\u0648\\u0634\\u0