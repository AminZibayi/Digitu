{
  "name": "@digikala/desktop",
  "version": "1.0.0",
  "description": "Digikala product and variant desktop automation suite",
  "author": "Digikala Automation Team",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && electron-builder --win --dir",
    "compile": "tsc && electron-builder --win",
    "dev": "electron dist/main.js"
  },
  "nx": {
    "implicitDependencies": [
      "@digikala/frontend"
    ]
  },
  "build": {
    "appId": "com.digikala.auto",
    "productName": "Digikala Automation Suite",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false,
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "frontend/out",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@digikala/core": "workspace:*",
    "@digikala/product-uploader": "workspace:*",
    "@digikala/variant-creator": "workspace:*",
    "better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.5"
  }
}
