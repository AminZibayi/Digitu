{
  "name": "@digikala/desktop",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron dist/main.js",
    "compile": "tsc",
    "dev": "tsc && electron dist/main.js",
    "package": "electron-builder --dir",
    "build": "tsc && electron-builder --dir"
  },
  "dependencies": {
    "@digikala/core": "workspace:*",
    "@digikala/product-uploader": "workspace:*",
    "@digikala/variant-creator": "workspace:*",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.digikala.automation",
    "productName": "Digikala Automation Suite",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "../frontend/out",
        "to": "frontend/out",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
